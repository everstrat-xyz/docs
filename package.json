{
  "name": "everstrat-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "bun run diagrams:gen && next build --turbopack",
    "dev": "next dev --turbopack",
    "start": "next start",
    "docs:gen": "fumadocs-mdx",
    "test:docs": "node --test scripts/docs-navigation.test.mjs",
    "diagrams:gen": "bun scripts/generate-diagrams.tsx",
    "test:content": "node --test scripts/docs-protocol-content.test.mjs",
    "test:markdown": "node --test scripts/docs-markdown-http.test.mjs",
    "types:check": "next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun run lint && bun run typecheck",
    "check:fix": "bun run lint:fix && bun run typecheck"
  },
  "dependencies": {
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "@takumi-rs/image-response": "^2.17.1",
    "class-variance-authority": "^0.7.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "@biomejs/biome": "2.6.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "24.x"
  }
}
